#!/usr/bin/env bash
# omarchy-mac-kit-extras: user override of omarchy-launch-screensaver (first in the session PATH,
# ~/.local/share/omk/bin). Runs Omarchy's own launcher, unchanged except for the foot terminal's
# config: a copy of Omarchy's screensaver.ini with the font scaled by OMK_SAVER_FONT_SCALE (default
# 1.25, so the rain's glyphs are a quarter bigger). Regenerated at every run from the stock file, so
# an Omarchy font change follows. If Omarchy's launcher no longer has the line we swap, it runs as
# is (stock font). Remove this file (or ./install.sh --undo screensaver) for the stock launcher.
OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
real=$OMARCHY_PATH/bin/omarchy-launch-screensaver
[[ -x $real ]] || real=/usr/bin/omarchy-launch-screensaver
stock_ini=$OMARCHY_PATH/default/foot/screensaver.ini
ini=${XDG_CONFIG_HOME:-$HOME/.config}/omk/screensaver-foot.ini
scale=${OMK_SAVER_FONT_SCALE:-1.25}
if [[ -r $stock_ini ]]; then
  mkdir -p "${ini%/*}"
  awk -v s="$scale" '
    /^font=/ && match($0, /size=[0-9.]+/) {
      size = substr($0, RSTART + 5, RLENGTH - 5) * s
      $0 = substr($0, 1, RSTART - 1) sprintf("size=%.1f", size) substr($0, RSTART + RLENGTH)
    }
    { print }' "$stock_ini" > "$ini.tmp" && mv -f "$ini.tmp" "$ini"
fi
if [[ -r $ini ]] && grep -q 'default/foot/screensaver.ini' "$real"; then
  # the same script, with foot's config path swapped (bash reads it from stdin; "$@" passes through)
  sed "s#\"\$OMARCHY_PATH/default/foot/screensaver.ini\"#\"$ini\"#" "$real" | exec bash -s -- "$@"
fi
exec "$real" "$@"
